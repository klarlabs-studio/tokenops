[Unit]
Description=TokenOps ingestion daemon
Documentation=https://team.klarlabs.de/
After=network-online.target

# `tokenops serve` is the MCP server and ingests nothing. This unit runs
# `tokenops start`, which owns the vendor-usage pollers that write events.db.

[Service]
Type=simple
ExecStart=__TOKENOPS_BIN__ start__TOKENOPS_CONFIG_ARGS__
Restart=on-failure
RestartSec=5
Environment=HOME=__HOME____TOKENOPS_CONFIG_ENV__

[Install]
WantedBy=default.target
