# Copy to .env (chmod 600) and fill in. Never commit .env.

# The DNS name pointing at this VPS (an A/AAAA record you create).
TEAM_DOMAIN=team.example.eu
# Let's Encrypt account e-mail for certificate expiry notices.
ACME_EMAIL=ops@example.eu

# Generate with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=change-me

# The release to run, without the leading v: the image
# ghcr.io/klarlabs-studio/tokenops-team:<TEAM_VERSION>. Keep it equal to the
# tag you checked out, so this directory's files match the image.
TEAM_VERSION=0.0.0

# Days the audit log is kept (who viewed whom, grants, removals).
AUDIT_RETENTION_DAYS=730

# Single sign-on (optional): the client secret your identity provider
# issued for this server. See README.md, "Single sign-on".
OIDC_CLIENT_SECRET=

# Nightly database dumps: where, and how many days to keep.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
