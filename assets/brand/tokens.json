        { "name": "surface", "light": "#FFFFFF", "dark": "#161A28", "use": "Cards and panels on the page." },
        { "name": "surface-2", "light": "#F7F8F9", "dark": "#1B2030", "use": "Quiet fills: chips, hovered rows, inline boxes." },
        { "name": "surface-3", "light": "#F0F1F3", "dark": "#222838", "use": "Stronger fills: code, table heads." },
        { "name": "sidebar", "light": "#FAFAFB", "dark": "#111524", "use": "Navigation column." },
        { "name": "border", "light": "#E4E6EA", "dark": "#262C3C", "use": "Hairlines and control borders." },
        { "name": "border-strong", "light": "#CFD3D9", "dark": "#353C4F", "use": "Borders that must read: inputs, hovered controls." },
