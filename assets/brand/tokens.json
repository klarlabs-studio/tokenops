        { "name": "overlay", "light": "rgba(255, 255, 255, 0.85)", "dark": "rgba(14, 18, 32, 0.82)", "use": "Behind a dialog." },
        { "name": "selection", "light": "rgba(198, 244, 50, 0.45)", "dark": "rgba(198, 244, 50, 0.45)", "use": "Selected text." }
      ]
