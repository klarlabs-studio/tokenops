    {
      "name": "Brand",
      "about": "The palette itself, the same in light and dark. Surfaces use the semantic colours below, not these.",
      "tokens": [
        { "name": "ink", "value": "#0E1220", "use": "Dark ground; text on lime." },
        { "name": "lime", "value": "#C6F432", "use": "Electric lime: fills that carry ink, and the accent on ink." },
        { "name": "lime-hover", "value": "#D4F75E", "use": "A lime fill under the pointer." },
        { "name": "lime-press", "value": "#B3E01C", "use": "A lime fill pressed." },
        { "name": "lime-dark", "value": "#3F6B0B", "use": "Lime as text, links, focus rings, bars and thin strokes on white.", "on": "white", "min": 5 },
        { "name": "lime-mark", "value": "#4D7C0F", "use": "The logo's ring on a light ground and chart bars; never text (4.99:1).", "on": "white", "min": 3 },
        { "name": "amber", "value": "#F59E0B", "use": "The token in the logo; warning fills and marks." },
        { "name": "red", "value": "#DC2626", "use": "Danger fills and over-limit bars." },
        { "name": "white", "value": "#FFFFFF", "use": "Light ground; vendor logo tiles." }
      ]
    },
    {
